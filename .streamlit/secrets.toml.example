# Rename this file to secrets.toml and paste your key. NEVER commit the real one.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional, only needed to scan other vendors' models.
# OPENAI_API_KEY = "sk-..."
# GOOGLE_API_KEY = "..."
# GROQ_API_KEY   = "gsk_..."

# Optional spend gate for a PUBLIC deployment. If set, visitors get the full
# interface in mock mode and only someone with the passcode can start a live
# scan, so a public link cannot quietly drain your API credits.
# Leave it unset for local use.
# POLYGUARD_PASSCODE = "pick-something-long"
